generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WantStatus {
  PENDING
  BOUGHT
  SKIPPED
}

enum OwnSource {
  MANUAL
  BOUGHT
}

enum ItemCategory {
  top
  bottom
  outer
  shoes
  bag
  etc
}

enum ItemColor {
  black
  white
  gray
  navy
  beige
  brown
  other
}

enum MembershipPlan {
  FREE
  PAID
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique @db.VarChar(320)
  passwordHash   String?        @db.VarChar(255)
  supabaseUserId String?        @unique @db.Uuid
  plan           MembershipPlan @default(FREE)
  trialSaveCount Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  wants          Want[]
  owns           Own[]
  saveRequests   SaveRequest[]
}

// Retain only a request fingerprint and item ID, never expired item content.
model SaveRequest {
  userId      String @db.Uuid
  key         String @db.VarChar(128)
  fingerprint String @db.VarChar(64)
  itemId      String @db.Uuid
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model Want {
  id             String       @id @default(uuid()) @db.Uuid
  title          String       @db.VarChar(120)
  url            String?      @db.Text
  category       ItemCategory
  categoryDetail String?      @db.VarChar(80)
  color          ItemColor
  colorDetail    String?      @db.VarChar(80)
  price          Int?
  note           String?      @db.Text
  status         WantStatus   @default(PENDING)
  expiresAt      DateTime?    @db.Timestamptz(3)
  userId         String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  own            Own?

  @@index([userId, status, createdAt])
  @@index([userId, category])
  @@index([expiresAt, userId])
}

model Own {
  id             String       @id @default(uuid()) @db.Uuid
  title          String       @db.VarChar(120)
  url            String?      @db.Text
  price          Int?
  note           String?      @db.Text
  category       ItemCategory
  categoryDetail String?      @db.VarChar(80)
  color          ItemColor
  colorDetail    String?      @db.VarChar(80)
  source         OwnSource    @default(MANUAL)
  fromWantId     String?      @unique @db.Uuid
  expiresAt      DateTime?    @db.Timestamptz(3)
  userId         String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  fromWant       Want?        @relation(fields: [fromWantId], references: [id], onDelete: SetNull)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category, color])
  @@index([userId, createdAt])
  @@index([expiresAt, userId])
}
